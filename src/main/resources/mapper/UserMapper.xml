<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.scenik.mapper.UserMapper">
  <resultMap id="UserResultMap" type="com.scenik.domain.User">
    <id property="userId" column="user_id" />
    <result property="email" column="email" />
    <result property="nickname" column="nickname" />
    <result property="passwordHash" column="password_hash" />
    <result property="role" column="role" />
    <result property="preferences" column="preferences" />
    <result property="profileImageUrl" column="profile_image_url" />
    <result property="bio" column="bio" />
    <result property="language" column="language" />
    <result property="status" column="status" />
    <result property="deletedAt" column="deleted_at" />
    <result property="authProvider" column="auth_provider" />
    <result property="createdAt" column="created_at" />
    <result property="updatedAt" column="updated_at" />
  </resultMap>

  <sql id="UserSelect">
    SELECT u.*,
           COALESCE(ur.role, 'ROLE_USER') AS role,
           COALESCE((
             SELECT oa.provider
             FROM oauth_accounts oa
             WHERE oa.user_id = u.user_id
             ORDER BY oa.updated_at DESC
             LIMIT 1
           ), 'email') AS auth_provider
    FROM users u
    LEFT JOIN user_roles ur ON ur.user_id = u.user_id
  </sql>

  <select id="findById" resultMap="UserResultMap">
    <include refid="UserSelect" />
    WHERE u.user_id = #{userId}
  </select>

  <select id="findByEmail" resultMap="UserResultMap">
    <include refid="UserSelect" />
    WHERE u.email = #{email}
  </select>

  <select id="findByNickname" resultMap="UserResultMap">
    <include refid="UserSelect" />
    WHERE u.nickname = #{nickname}
    LIMIT 1
  </select>

  <insert id="insert" parameterType="com.scenik.domain.User" useGeneratedKeys="true" keyProperty="userId" keyColumn="user_id">
    INSERT INTO users (email, nickname, password_hash, preferences, profile_image_url, language)
    VALUES (#{email}, #{nickname}, #{passwordHash}, #{preferences}, #{profileImageUrl}, #{language})
  </insert>

  <update id="updateProfile">
    UPDATE users
    SET nickname = #{nickname},
        bio = #{bio},
        preferences = #{preferences},
        language = #{language}
    WHERE user_id = #{userId}
  </update>

  <update id="updateProfileImage">
    UPDATE users
    SET profile_image_url = #{profileImageUrl}
    WHERE user_id = #{userId}
  </update>

  <update id="clearProfileImage">
    UPDATE users
    SET profile_image_url = NULL
    WHERE user_id = #{userId}
  </update>

  <update id="updatePassword">
    UPDATE users
    SET password_hash = #{passwordHash}
    WHERE user_id = #{userId}
      AND (status IS NULL OR status != 'DELETED')
  </update>

  <delete id="deleteFollows">DELETE FROM follows WHERE follower_id = #{userId} OR following_id = #{userId}</delete>
  <delete id="deleteRoutes">DELETE FROM travel_routes WHERE user_id = #{userId}</delete>
  <delete id="deleteContentLikes">DELETE FROM content_likes WHERE user_id = #{userId}</delete>
  <delete id="deletePlaceLikes">DELETE FROM place_likes WHERE user_id = #{userId}</delete>
  <delete id="deleteVisitStatuses">DELETE FROM visit_status WHERE user_id = #{userId}</delete>
  <delete id="deletePlaceReviews">DELETE FROM place_reviews WHERE user_id = #{userId}</delete>
  <delete id="deletePostLikes">DELETE FROM post_likes WHERE user_id = #{userId}</delete>
  <delete id="deletePostScraps">DELETE FROM post_scraps WHERE user_id = #{userId}</delete>
  <delete id="deleteCommentLikes">DELETE FROM comment_likes WHERE user_id = #{userId}</delete>
  <delete id="deleteReports">DELETE FROM reports WHERE user_id = #{userId}</delete>
  <delete id="deleteNotifications">DELETE FROM notifications WHERE user_id = #{userId}</delete>
  <update id="clearTranslationCacheUser">UPDATE translation_cache SET user_id = NULL WHERE user_id = #{userId}</update>
  <delete id="deleteOAuthAccounts">DELETE FROM oauth_accounts WHERE user_id = #{userId}</delete>
  <delete id="deleteOAuthLoginCodes">DELETE FROM oauth_login_codes WHERE user_id = #{userId}</delete>
  <delete id="deleteRoles">DELETE FROM user_roles WHERE user_id = #{userId}</delete>

  <update id="anonymizeAndDeactivate">
    UPDATE users
    SET email = #{email},
        nickname = #{nickname},
        password_hash = #{passwordHash},
        preferences = NULL,
        profile_image_url = NULL,
        bio = NULL,
        language = 'ko',
        status = 'DELETED',
        deleted_at = CURRENT_TIMESTAMP
    WHERE user_id = #{userId}
      AND (status IS NULL OR status != 'DELETED')
  </update>
</mapper>
