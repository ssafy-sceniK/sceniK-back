# Active profile: local (default) or prod on EC2.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Local: jdbc:mysql://localhost:3306/scenik?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
# EC2: keep MySQL private and use 127.0.0.1 when it runs on the same host.
DB_URL=jdbc:mysql://127.0.0.1:3306/scenik?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=your_mysql_username
DB_PASSWORD=replace_with_a_strong_password

# Comma-separated browser origins. Add the S3 website, CloudFront, or custom domain here.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://your-s3-static-website-endpoint

# Persistent absolute path recommended on EC2.
UPLOAD_DIR=/opt/scenik/uploads

# Backend callback base and browser callback page.
OAUTH_BASE_URL=http://your-ec2-public-ip
OAUTH_FRONTEND_REDIRECT_URI=http://your-s3-static-website-endpoint/oauth/callback
PASSWORD_RESET_FRONTEND_URL=http://your-s3-static-website-endpoint/password-reset
GOOGLE_OAUTH_CLIENT_ID=replace_with_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=replace_with_google_client_secret
KAKAO_OAUTH_CLIENT_ID=replace_with_kakao_rest_api_key
KAKAO_OAUTH_CLIENT_SECRET=replace_with_kakao_client_secret

GMS_BASE_URL=https://gms.ssafy.io/gmsapi/
GMS_KEY=replace_with_gms_key
GMS_MODEL=gpt-5.4-mini
GMS_TRANSLATION_MODEL=gpt-5-nano
GMS_CONNECT_TIMEOUT_MS=1000
GMS_READ_TIMEOUT_MS=5000
