<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.scenik.mapper.PlaceReviewMapper">
  <resultMap id="PlaceReviewResultMap" type="com.scenik.domain.PlaceReview">
    <id property="reviewId" column="review_id" />
    <result property="placeId" column="place_id" />
    <result property="userId" column="user_id" />
    <result property="nickname" column="nickname" />
    <result property="rating" column="rating" />
    <result property="content" column="content" />
    <result property="createdAt" column="created_at" />
    <result property="updatedAt" column="updated_at" />
  </resultMap>

  <sql id="ReviewSelect">
    SELECT pr.*, u.nickname AS nickname
    FROM place_reviews pr
    JOIN users u ON u.user_id = pr.user_id
  </sql>

  <select id="findByPlaceId" resultMap="PlaceReviewResultMap">
    <include refid="ReviewSelect" />
    WHERE pr.place_id = #{placeId}
    ORDER BY pr.updated_at DESC, pr.created_at DESC
  </select>

  <select id="findByUserId" resultMap="PlaceReviewResultMap">
    <include refid="ReviewSelect" />
    WHERE pr.user_id = #{userId}
    ORDER BY pr.updated_at DESC, pr.created_at DESC
  </select>

  <select id="findById" resultMap="PlaceReviewResultMap">
    <include refid="ReviewSelect" />
    WHERE pr.review_id = #{reviewId}
  </select>

  <select id="findByPlaceIdAndUserId" resultMap="PlaceReviewResultMap">
    <include refid="ReviewSelect" />
    WHERE pr.place_id = #{placeId}
      AND pr.user_id = #{userId}
  </select>

  <insert id="insert" parameterType="com.scenik.domain.PlaceReview" useGeneratedKeys="true" keyProperty="reviewId">
    INSERT INTO place_reviews (place_id, user_id, rating, content)
    VALUES (#{placeId}, #{userId}, #{rating}, #{content})
  </insert>

  <update id="update" parameterType="com.scenik.domain.PlaceReview">
    UPDATE place_reviews
    SET rating = #{rating},
        content = #{content}
    WHERE review_id = #{reviewId}
  </update>

  <delete id="delete">
    DELETE FROM place_reviews WHERE review_id = #{reviewId}
  </delete>
</mapper>
